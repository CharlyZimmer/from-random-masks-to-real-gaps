# Gap-Aware environment configuration
#
# Template for the variables the scripts and notebooks read. Copy the lines you
# need into your ~/.bashrc (or a sourced .env file) and replace the placeholder
# paths with your own. Paths that are left unset fall back to the repo-relative
# defaults under esdc/data/ and sentinel/data/ (scripts are run from the repo root).

# --- Project ---
# Repository root (used by notebooks and Slurm jobs to locate model_gap_aware/)
export GAP_AWARE_ROOT=/path/to/gap-aware

# --- ESDC ---
# Pre-training data directory (contains dataset.h5; lmdb/ is written here)
export ESDC_DATA_DIR=/path/to/esdc/lst_no_syn_gaps
# Gap-filling evaluation set (contains dataset.h5)
export ESDC_GAP_FILLING_DIR=/path/to/esdc/lst_gap_filling
# Gap-filling training set (contains dataset.h5; lmdb/ is written here)
export ESDC_GAP_FILLING_TRAINING_DIR=/path/to/esdc/lst_gap_filling_training
# Directory containing computed_ranges.json (data-cube value range lookup)
export ESDC_COMPUTED_RANGES_DIR=/path/to/esdc
# Optional: checkpoint of the standalone pre-training pipeline
# (esdc/scripts/*/training.sh), used for ad-hoc downstream inference such as
# esdc/src/datacube_gapfilling/fill_datacube.py
# export ESDC_PRETRAINED_CKPT=/path/to/checkpoint.ckpt

# --- Sentinel-2 ---
# Data root (contains the SSL-consecutive/ GeoTIFF tree and gap_filling/)
export S2_DATA_DIR=/path/to/sentinel/data
# Pre-training LMDB (the matching *_test.lmdb is expected next to it)
export S2_LMDB_PATH=/path/to/sentinel/data/ssl4eo_consecutive_s2c.lmdb
# Gap-filling training set (synthetic gap masks for the pre-training locations)
export S2_GAP_FILLING_TRAINING_DIR=/path/to/sentinel/data/gap_filling_training

# --- Google Earth Engine (Sentinel-2 download scripts) ---
# Google Cloud project with Earth Engine enabled
export EE_PROJECT=your-gcp-project-id
# Service account and JSON key file (only needed by the Slurm download scripts;
# local scripts use your interactive `earthengine authenticate` credentials)
export EE_SERVICE_ACCOUNT=your-service-account@your-gcp-project-id.iam.gserviceaccount.com
export EE_KEY_FILE=/path/to/service-account-key.json
